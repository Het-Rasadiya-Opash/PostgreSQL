// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  ADMIN
  CUSTOMER
  DELIVERY
}

enum RestaurantStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  PENDING
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  CASH_ON_DELIVERY
  UPI
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELLED
}

model User {
  id                  Int                  @id @default(autoincrement())
  fullName            String
  email               String               @unique
  phoneNumber         String               @unique
  type                UserType             @default(CUSTOMER)
  address             String?
  updatedAt           DateTime             @updatedAt
  createdAt           DateTime             @default(now())
  orders              Order[]
  deliveryAssignments DeliveryAssignment[]
  reviewsWritten      Review[]             @relation("Reviewer")
  deliveryReviews     Review[]             @relation("Delivery")
}

model Restaurant {
  id        Int              @id @default(autoincrement())
  name      String
  address   String
  status    RestaurantStatus @default(OPEN)
  updatedAt DateTime         @updatedAt
  createdAt DateTime         @default(now())
  menuItems MenuItem[]
  orders    Order[]
  reviews   Review[]
}

model MenuItem {
  id           Int     @id @default(autoincrement())
  name         String
  price        Float
  category     String
  availability Boolean @default(true)

  // Relation to Restaurant ONE TO MANY
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  updatedAt  DateTime    @updatedAt
  createdAt  DateTime    @default(now())
  orderItems OrderItem[]
}

model Order {
  id Int @id @default(autoincrement())

  // Relation to User ONE TO MANY
  userId Int
  user   User @relation(fields: [userId], references: [id])

  // Relation to Restaurant ONE TO MANY
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  orderStatus OrderStatus @default(PENDING)

  placedAt         DateTime  @default(now())
  acceptedAt       DateTime?
  preparedAt       DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?

  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY)

  deliveryInructions String?

  updatedAt           DateTime             @updatedAt
  createdAt           DateTime             @default(now())
  orderItems          OrderItem[]
  deliveryAssignments DeliveryAssignment[]
}

model OrderItem {
  id Int @id @default(autoincrement())

  // Relation to Order ONE TO MANY
  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  // Relation to MenuItem ONE TO MANY
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  quantity Int @default(1)

  priceAtPurchase Float

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model DeliveryAssignment {
  id Int @id @default(autoincrement())

  // Relation to Order ONE TO ONE
  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  // Relation to User (Delivery Person) ONE TO ONE
  deliveryPersonId Int
  deliveryPerson   User @relation(fields: [deliveryPersonId], references: [id])

  status DeliveryStatus @default(ASSIGNED)

  assignedAt  DateTime  @default(now())
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  expectedDeliveryTime DateTime?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Review {
  id Int @id @default(autoincrement())

  // Relation to User ONE TO MANY
  // The person writing the review
  reviewerId Int
  reviewer   User @relation("Reviewer", fields: [reviewerId], references: [id])

  // The Restaurant being reviewed (Optional)
  restaurantId Int?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])

  // The Delivery Person being reviewed (Optional)
  deliveryPersonId Int?
  deliveryPerson   User? @relation("Delivery", fields: [deliveryPersonId], references: [id])

  rating  Int     @default(5)
  comment String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

